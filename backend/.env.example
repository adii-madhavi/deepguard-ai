# Environment variables are read from the process, not automatically from this file.
DEEPGUARD_MODEL=haywoodsloan/ai-image-detector-dev-deploy
DEEPGUARD_REVISION=3824a1e5fb831d4347cb63dfcb3f2a752d987ef2
DEEPGUARD_AI_LABEL=artificial
DEEPGUARD_ENABLE_MODEL=1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://adii-madhavi.github.io
DEEPGUARD_AUDIO_MODEL=mo-thecreator/Deepfake-audio-detection
DEEPGUARD_AUDIO_REVISION=e4d9874b493362149cec96ced85f00b00b1a04c0
DEEPGUARD_ENABLE_AUDIO_MODEL=1
# Public-hosting controls (all optional; defaults suit local use)
DEEPGUARD_API_KEYS=
DEEPGUARD_RATE_LIMIT=0
DEEPGUARD_RATE_WINDOW_SECONDS=600
DEEPGUARD_QUEUE_SIZE=0
DEEPGUARD_QUEUE_TIMEOUT_SECONDS=90
# Per-browser report history (SQLite)
DEEPGUARD_HISTORY=1
DEEPGUARD_DB=../data/reports.db
DEEPGUARD_HISTORY_LIMIT=50
